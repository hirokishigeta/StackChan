# StackChan backend 設定テンプレート。`backend/.env` にコピーして使う（.env は .gitignore 済み）。
# pydantic-settings が読み込む。未設定の項目はコード既定（dummy provider 等）で動く。

# ===== 最小: まず接続テストだけなら以下だけでよい（provider は dummy のまま）=====
# device が到達できる LAN アドレスを必ず設定（127.0.0.1 では CoreS3 から届かない）
STACKCHAN_OTA_WS_HOST=127.0.0.1
STACKCHAN_OTA_WS_PORT=8000

# ===== ASR: sherpa-onnx 日本語 (ReazonSpeech zipformer, int8, CPU) =====
# モデル取得（任意のフォルダへ）:
#   wget https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/sherpa-onnx-zipformer-ja-reazonspeech-2024-08-01.tar.bz2
#   tar xjf sherpa-onnx-zipformer-ja-reazonspeech-2024-08-01.tar.bz2
# macOS(arm64) の sherpa 導入は pyproject の find-links + sherpa-onnx-core 経由で
#   uv sync --extra sherpa --extra opus  だけで onnxruntime 同梱版が入る。
#STACKCHAN_DEFAULT_SPEECH_PROVIDER=sherpa-onnx
#STACKCHAN_SHERPA_TOKENS_PATH=/path/to/sherpa-onnx-zipformer-ja-reazonspeech-2024-08-01/tokens.txt
#STACKCHAN_SHERPA_ENCODER_PATH=/path/to/.../encoder-epoch-99-avg-1.int8.onnx
#STACKCHAN_SHERPA_DECODER_PATH=/path/to/.../decoder-epoch-99-avg-1.int8.onnx
#STACKCHAN_SHERPA_JOINER_PATH=/path/to/.../joiner-epoch-99-avg-1.int8.onnx
#STACKCHAN_SHERPA_SAMPLE_RATE=16000
#STACKCHAN_SHERPA_NUM_THREADS=2

# 上り音声は device が Opus を送るのでデコードに opus を使う（libopus 必要: brew install opus）
#STACKCHAN_AUDIO_DECODER=opus

# ===== LLM (OpenAI 互換 / 既定は Ollama 想定)。未起動時は安全フォールバック応答 =====
#STACKCHAN_AGENT_BASE_URL=http://localhost:11434/v1
#STACKCHAN_AGENT_API_KEY=
#STACKCHAN_DEFAULT_AGENT_MODEL=qwen2.5

# ===== 画像認識 (顔検出/注視/自発話しかけ)。uv sync --extra vision 後に有効化 =====
#STACKCHAN_DEFAULT_VISION_PROVIDER=opencv

# ===== 下り TTS (Irodori-TTS, ADR-0006)。GPU 推奨・アダプタは #7-b TODO。当面 dummy 推奨 =====
#STACKCHAN_DEFAULT_TTS_PROVIDER=irodori
#STACKCHAN_AUDIO_ENCODER=opus
#STACKCHAN_IRODORI_MODEL_PATH=/path/to/Irodori-TTS-500M
#STACKCHAN_IRODORI_REFERENCE_WAV_PATH=/path/to/voice.wav
#STACKCHAN_IRODORI_DEVICE=cpu
