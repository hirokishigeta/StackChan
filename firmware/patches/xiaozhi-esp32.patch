     codec_ = codec;
     codec_->Start();
+    // Keep the output codec/power-amp (AW88298) enabled from boot. The upstream
+    // behavior enables output lazily on the first decoded frame and powers it
+    // down after a timeout, so every TTS turn re-ramps the amp and clips the
+    // opening syllable. Like the original M5Stack StackChan (amp always on), we
+    // enable it once here and never auto-disable it (see CheckAndUpdateAudio-
+    // PowerState), so the amp is always warm and playback starts cleanly.
+    codec_->EnableOutput(true);
 
     esp_opus_dec_cfg_t opus_dec_cfg = OPUS_DEC_CFG(codec->output_sample_rate(), OPUS_FRAME_DURATION_MS);
     auto ret = esp_opus_dec_open(&opus_dec_cfg, sizeof(esp_opus_dec_cfg_t), &opus_decoder_);
@@ -679,6 +686,17 @@ void AudioService::ResetDecoder() {
