 }
 
+void AudioService::PreEnableOutput() {
+    // Warm up the output codec/amp before the first playback frame arrives.
+    // Uses the same enable path as AudioOutputTask()/PlaySound() and is
+    // idempotent (codec_->EnableOutput is a no-op if already enabled).
+    if (!codec_->output_enabled()) {
+        esp_timer_stop(audio_power_timer_);
+        esp_timer_start_periodic(audio_power_timer_, AUDIO_POWER_CHECK_INTERVAL_MS * 1000);
+        codec_->EnableOutput(true);
+    }
+}
+
 void AudioService::CheckAndUpdateAudioPowerState() {
     auto now = std::chrono::steady_clock::now();
     auto input_elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(now - last_input_time_).count();
@@ -686,15 +704,11 @@ void AudioService::CheckAndUpdateAudioPowerState() {
     if (input_elapsed > AUDIO_POWER_TIMEOUT_MS && codec_->input_enabled()) {
         codec_->EnableInput(false);
     }
-    if (output_elapsed > AUDIO_POWER_TIMEOUT_MS && codec_->output_enabled()) {
-        // Keep TX clock when duplex RX is active; otherwise RX may stall on some boards.
-        if (!(codec_->duplex() && codec_->input_enabled())) {
-            codec_->EnableOutput(false);
-        }
-    }
-    if (!codec_->input_enabled() && !codec_->output_enabled()) {
-        esp_timer_stop(audio_power_timer_);
-    }
+    // NOTE: the output codec/amp is intentionally NOT powered down on timeout.
+    // We keep it always-on (enabled at boot) so the AW88298 amp stays warm and
+    // TTS playback never re-ramps mid-utterance (which clipped the opening
+    // syllable). Power saving on output is traded for clean, gap-free playback.
+    (void)output_elapsed;
 }
 
